#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "StereoImageMaterial"
    {
        asset inputs:LeftImage = @placeholder.png@
        asset inputs:RightImage = @placeholder.png@
        color3f inputs:KeyColor = (0, 1, 0)
        float inputs:Threshold = 0.4
        float inputs:Smoothness = 0.1
        float inputs:ChromaEnable = 0
        asset inputs:LeftMask = @placeholder.png@
        asset inputs:RightMask = @placeholder.png@
        float inputs:MaskEnable = 0
        float inputs:MaskThreshold = 0.5
        float inputs:MaskFeather = 0.05
        token outputs:mtlx:surface.connect = </Root/StereoImageMaterial/UnlitSurface.outputs:out>

        def Shader "UnlitSurface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = 0
            color3f inputs:color.connect = </Root/StereoImageMaterial/CameraIndexSwitch.outputs:out>
            bool inputs:hasPremultipliedAlpha = false
            float inputs:opacity.connect = </Root/StereoImageMaterial/OpacityCombine.outputs:out>
            token outputs:out
        }

        def Shader "CameraIndexSwitch"
        {
            uniform token info:id = "ND_realitykit_geometry_switch_cameraindex_color3"
            color3f inputs:mono.connect = </Root/StereoImageMaterial/LeftImageNode.outputs:out>
            color3f inputs:left.connect = </Root/StereoImageMaterial/LeftImageNode.outputs:out>
            color3f inputs:right.connect = </Root/StereoImageMaterial/RightImageNode.outputs:out>
            color3f outputs:out
        }

        def Shader "LeftImageNode"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default
            asset inputs:file = @placeholder.png@
            asset inputs:file.connect = </Root/StereoImageMaterial.inputs:LeftImage>
            string inputs:filtertype = "linear"
            color3f outputs:out
        }

        def Shader "RightImageNode"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default
            asset inputs:file = @placeholder.png@
            asset inputs:file.connect = </Root/StereoImageMaterial.inputs:RightImage>
            string inputs:filtertype = "linear"
            color3f outputs:out
        }

        # --- Chroma key: per-eye background transparency ---
        # 各眼で実際に表示される色 (CameraIndexSwitch 後) を vector3 に変換し、
        # KeyColor との RGB 距離からアルファを生成する。左右独立に処理されるため
        # 立体視 (視差) はそのまま保たれ、背景キー色付近だけが透明になる。

        def Shader "PixelToVec"
        {
            uniform token info:id = "ND_convert_color3_vector3"
            color3f inputs:in.connect = </Root/StereoImageMaterial/CameraIndexSwitch.outputs:out>
            vector3f outputs:out
        }

        def Shader "KeyToVec"
        {
            uniform token info:id = "ND_convert_color3_vector3"
            color3f inputs:in.connect = </Root/StereoImageMaterial.inputs:KeyColor>
            vector3f outputs:out
        }

        def Shader "ColorDiff"
        {
            uniform token info:id = "ND_subtract_vector3"
            vector3f inputs:in1.connect = </Root/StereoImageMaterial/PixelToVec.outputs:out>
            vector3f inputs:in2.connect = </Root/StereoImageMaterial/KeyToVec.outputs:out>
            vector3f outputs:out
        }

        def Shader "ColorDistance"
        {
            uniform token info:id = "ND_magnitude_vector3"
            vector3f inputs:in.connect = </Root/StereoImageMaterial/ColorDiff.outputs:out>
            float outputs:out
        }

        def Shader "HighEdge"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/StereoImageMaterial.inputs:Threshold>
            float inputs:in2.connect = </Root/StereoImageMaterial.inputs:Smoothness>
            float outputs:out
        }

        # 距離 < Threshold (キー色に近い) -> 0 (透明)
        # 距離 > Threshold + Smoothness (キー色から遠い前景) -> 1 (不透明)
        def Shader "ChromaAlpha"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/StereoImageMaterial/ColorDistance.outputs:out>
            float inputs:low.connect = </Root/StereoImageMaterial.inputs:Threshold>
            float inputs:high.connect = </Root/StereoImageMaterial/HighEdge.outputs:out>
            float outputs:out
        }

        # ChromaEnable=0 -> 常に 1.0 (従来通り不透明)。
        # ChromaEnable=1 -> ChromaAlpha を採用 (背景透過)。
        def Shader "FinalOpacity"
        {
            uniform token info:id = "ND_mix_float"
            float inputs:bg = 1.0
            float inputs:fg.connect = </Root/StereoImageMaterial/ChromaAlpha.outputs:out>
            float inputs:mix.connect = </Root/StereoImageMaterial.inputs:ChromaEnable>
            float outputs:out
        }

        # --- 前景抽出 (Vision 被写体マスク): 背景を透過 ---
        # 各眼のマスク (前景=1 / 背景=0) をカメラインデックスで切り替え、
        # しきい値 +/- ぼかしで smoothstep してアルファ化する。クロマキーとは
        # 独立に乗算で合成されるため、両方を併用できる。

        def Shader "LeftMaskNode"
        {
            uniform token info:id = "ND_image_float"
            float inputs:default = 1
            asset inputs:file = @placeholder.png@
            asset inputs:file.connect = </Root/StereoImageMaterial.inputs:LeftMask>
            string inputs:filtertype = "linear"
            float outputs:out
        }

        def Shader "RightMaskNode"
        {
            uniform token info:id = "ND_image_float"
            float inputs:default = 1
            asset inputs:file = @placeholder.png@
            asset inputs:file.connect = </Root/StereoImageMaterial.inputs:RightMask>
            string inputs:filtertype = "linear"
            float outputs:out
        }

        def Shader "MaskSwitch"
        {
            uniform token info:id = "ND_realitykit_geometry_switch_cameraindex_float"
            float inputs:mono.connect = </Root/StereoImageMaterial/LeftMaskNode.outputs:out>
            float inputs:left.connect = </Root/StereoImageMaterial/LeftMaskNode.outputs:out>
            float inputs:right.connect = </Root/StereoImageMaterial/RightMaskNode.outputs:out>
            float outputs:out
        }

        def Shader "MaskLow"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/StereoImageMaterial.inputs:MaskThreshold>
            float inputs:in2.connect = </Root/StereoImageMaterial.inputs:MaskFeather>
            float outputs:out
        }

        def Shader "MaskHigh"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/StereoImageMaterial.inputs:MaskThreshold>
            float inputs:in2.connect = </Root/StereoImageMaterial.inputs:MaskFeather>
            float outputs:out
        }

        # マスク値 < Threshold-Feather (背景) -> 0 (透明)
        # マスク値 > Threshold+Feather (前景) -> 1 (不透明)
        def Shader "MaskAlpha"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in.connect = </Root/StereoImageMaterial/MaskSwitch.outputs:out>
            float inputs:low.connect = </Root/StereoImageMaterial/MaskLow.outputs:out>
            float inputs:high.connect = </Root/StereoImageMaterial/MaskHigh.outputs:out>
            float outputs:out
        }

        # MaskEnable=0 -> 1.0 (前景抽出オフ)。MaskEnable=1 -> MaskAlpha。
        def Shader "MaskApplied"
        {
            uniform token info:id = "ND_mix_float"
            float inputs:bg = 1.0
            float inputs:fg.connect = </Root/StereoImageMaterial/MaskAlpha.outputs:out>
            float inputs:mix.connect = </Root/StereoImageMaterial.inputs:MaskEnable>
            float outputs:out
        }

        # クロマキーと前景抽出を乗算合成 (両オフなら 1.0)。
        def Shader "OpacityCombine"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/StereoImageMaterial/FinalOpacity.outputs:out>
            float inputs:in2.connect = </Root/StereoImageMaterial/MaskApplied.outputs:out>
            float outputs:out
        }
    }
}
